items.Rune_Levitate.name= Levitate
items.Rune_Levitate.description= A rune that lets you levitate into the air for a few seconds, beware of the fall!\n\nCan be canceled early by using ability again.
items.Rune_LastStand.name= Last Stand
items.Rune_LastStand.description= A rune that fully restores all health, stamina and mana! Has a long cooldown though.
items.Rune_Dash.name= Dash
items.Rune_Dash.description= Allows the user to launch towards the direction they are currently moving.
items.Rune_Tiny.name= Tiny
items.Rune_Tiny.description= Makes the user Tiny! This comes at the cost of a few of your stats though..